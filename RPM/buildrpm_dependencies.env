#!/bin/bash
# Get an environment variables including a list of dependency packages required to build an RPM according to detected distro

# Common packages required for all distributions
COMMON_PACKAGES="rpm rsync"

# Packages specific to each distro/OS
EL_PACKAGES="rpm-build rpmdevtools"
UB_PACKAGES="alien dpkg-dev python3-dev"

if [ -e /etc/redhat-release ]; then
    DISTRO_PACKAGES="$EL_PACKAGES"
elif [[ "$(cat /etc/os-release 2>/dev/null)" =~ Ubuntu ]]; then
    DISTRO_PACKAGES="$UB_PACKAGES"
else
    echo "WARNING: Cannot determine OS type. Please manually set DISTRO_PACKAGES."
    DISTRO_PACKAGES="${DISTRO_PACKAGES:-}"
fi

# Combine common packages and distro-specific packages
BUILDRPM_DEPENDENCIES="$COMMON_PACKAGES $DISTRO_PACKAGES"

export BUILDRPM_DEPENDENCIES