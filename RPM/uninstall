# ============================ UNINSTALLING NVMESH UPGRADE AGENT ============================
# Removes everything the upgrade agent leaves behind on the file system.
#
# This script is invoked from the package %preun scriptlet with the scriptlet argument ($1)
# so that cleanup happens ONLY on a real uninstall and NEVER during an upgrade:
#   - RPM:  $1 == "0"       -> uninstall   (during an upgrade $1 == "1")
#   - DEB:  $1 == "remove"  -> uninstall   (during an upgrade $1 == "upgrade")

service_name=nvmeshupgradeagent

JOURNAL_DIR=/var/opt/nvmesh/upgradeagent
TLS_CERTS_DIR=/var/run/nvmesh/tls/nvmeshupgradeagent

# not an upgrade
if [ "$1" = "0" -o "$1" = "remove" ]; then
    echo "Uninstalling NVMesh(r) upgrade agent"

    systemctl stop "$service_name" > /dev/null 2>&1
    systemctl disable "$service_name" > /dev/null 2>&1

    if systemctl is-failed "$service_name" > /dev/null 2>&1; then
        systemctl reset-failed "$service_name" > /dev/null 2>&1
    fi

    echo "Removing upgrade agent runtime state"
    rm -rf "${JOURNAL_DIR:?}"/* "$TLS_CERTS_DIR"
fi

exit 0
